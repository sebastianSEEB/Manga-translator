# Generate BACKEND_TOKEN using python scripts/configure.py
BACKEND_TOKEN=
# Default: a local OpenAI-compatible server. Set its installed model name.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=
LLM_API_KEY=
# Remote endpoint requires HTTPS and explicit opt-in. Only OCR text is sent.
LLM_ALLOW_REMOTE=false
# Set false for servers supporting JSON mode but not strict JSON schema.
LLM_STRICT_SCHEMA=true
OCR_FORCE_CPU=false
DETECTOR_INPUT_SIZE=1024
DETECTOR_CONFIDENCE=0.4
MAX_REGIONS=80
CACHE_PAGES=24
CACHE_TTL_SECONDS=1800
# For iPhone: exact Tailscale Serve hostname, no scheme or path.
EXTRA_ALLOWED_HOSTS=
# Optional full path to an English TrueType font for iPhone rendering.
RENDER_FONT=
